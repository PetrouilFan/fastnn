#version 450
// FN3-11 (#57) smoke kernel: element-wise Add over contiguous f32 buffers.
//
//     out[i] = a[i] + b[i]
//
// The host dispatches ceil(n / 64) workgroups, so the final workgroup has
// inactive invocations for a non-multiple-of-64 element count; the bounds
// check below rejects them. `n` is a push constant so the same pipeline serves
// every length without recompiling.
//
// Bindings and the push-constant size are mirrored by
// `kernels::smoke::SMOKE_ADD`; `kernels::reflect` cross-checks this module
// against that declaration at registration time.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer A {
    float a[];
};

layout(set = 0, binding = 1, std430) readonly buffer B {
    float b[];
};

layout(set = 0, binding = 2, std430) writeonly buffer Out {
    float outv[];
};

layout(push_constant) uniform Params {
    uint n;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) {
        return;
    }
    outv[i] = a[i] + b[i];
}
